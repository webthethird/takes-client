{
  "name": "takes-client",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json",
    "test": "vitest run",
    "classify": "node --env-file=.dev.vars scripts/classify.mts",
    "eval-stakes": "node --env-file=.dev.vars scripts/eval-stakes.mts",
    "eval-merge": "node --env-file=.dev.vars scripts/eval-merge.mts",
    "eval-breadth": "node --env-file=.dev.vars scripts/eval-breadth.mts",
    "start": "expo start",
    "web": "expo start --web",
    "ios": "warpstack-vault-build && expo run:ios --device",
    "ios:release": "warpstack-vault-build && expo run:ios --device --configuration Release",
    "build:web": "expo export -p web --output-dir dist && node scripts/web-headers.mjs",
    "dev": "expo export -p web --output-dir dist && node scripts/web-headers.mjs && node scripts/offline-config.mjs && wrangler d1 migrations apply DB --local -c wrangler.offline.jsonc && wrangler d1 migrations apply TAKES --local -c wrangler.offline.jsonc && wrangler dev --local -c wrangler.offline.jsonc",
    "deploy": "node scripts/deploy.mjs",
    "dev:remote": "expo export -p web --output-dir dist && node scripts/web-headers.mjs && wrangler d1 migrations apply DB --local && wrangler dev"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@expo/metro-runtime": "58.0.14",
    "@noble/hashes": "2.4.0",
    "@tanstack/react-query": "5.105.3",
    "@warpstack/api": "0.1.0",
    "@warpstack/app-core": "0.1.0",
    "@warpstack/client": "0.1.0",
    "@warpstack/contract": "0.1.0",
    "@warpstack/ui": "0.1.0",
    "@warpstack/wallet": "0.1.0",
    "expo": "58.0.14",
    "expo-constants": "58.0.12",
    "expo-file-system": "58.0.9",
    "expo-image": "58.0.15",
    "expo-image-manipulator": "58.0.14",
    "expo-image-picker": "58.0.10",
    "expo-linking": "58.0.13",
    "expo-router": "58.0.23",
    "expo-secure-store": "58.0.2",
    "expo-status-bar": "58.0.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "0.21.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261018.1",
    "@types/react": "19.3.0",
    "typescript": "6.0.3",
    "vitest": "^5.1.0",
    "wrangler": "4.151.1"
  },
  "engines": {
    "node": ">=22"
  }
}
